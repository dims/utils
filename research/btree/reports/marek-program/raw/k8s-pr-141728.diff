+		}
+		res.NumFetched++
+
+		if req.ComputeTotalCount {
+			res.TotalCount++
+		}
+
+		if req.Limit > 0 && int64(res.NumMatched) >= req.Limit {
+			res.HasMore = true
+			if !req.ComputeTotalCount {
+				return false
+			}
+			return true
+		}
+
+		if req.Filter != nil {
+			matches, err := req.Filter(item)
+			if err != nil {
+				procErr = err
+				return false
+			}
+			if !matches {
+				return true
+			}
+		}
+
+		res.NumMatched++
+		res.LastSelectedObjectKey = item.Key
+		if req.Consume != nil {
+			if err := req.Consume(item); err != nil {
+				procErr = err
+				return false
+			}
+		}
+		return true
+	})
+
+	if procErr != nil {
+		return ListResult{}, procErr
+	}
+	return res, nil
+}
