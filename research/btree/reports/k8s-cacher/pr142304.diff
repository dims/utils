diff --git a/pkg/kubeapiserver/direct/client.go b/pkg/kubeapiserver/direct/client.go
new file mode 100644
index 0000000000000..9cc519003bfd9
--- /dev/null
+++ b/pkg/kubeapiserver/direct/client.go
@@ -0,0 +1,113 @@
+/*
